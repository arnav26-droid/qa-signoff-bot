# From "OAuth & Permissions" in your Slack app settings
SLACK_BOT_TOKEN=xoxb-your-bot-token

# From "Basic Information" > "App-Level Tokens" (needs connections:write scope)
SLACK_APP_TOKEN=xapp-your-app-level-token

# From "Basic Information" > "Signing Secret"
SLACK_SIGNING_SECRET=your-signing-secret

# The channel ID (not name) to fall back to if a message somehow can't be tied to the
# channel /qa was run in (rare — normally every message posts to that same channel).
QA_STATUS_CHANNEL_ID=C0123456789
